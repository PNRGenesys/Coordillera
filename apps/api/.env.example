# Local development with docker compose
DATABASE_URL=postgresql://cordillera:cordillera_dev@localhost:5432/cordillera
PORT=3000
# Lifetime of the customer session cookie.
SESSION_TTL_DAYS=30
# Minimum length accepted when registering an account.
PASSWORD_MIN_LENGTH=8
# Longest data URL accepted for a profile picture.
AVATAR_MAX_CHARACTERS=200000
